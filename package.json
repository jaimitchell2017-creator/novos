{
  "name": "novos-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "desktop:build": "vite build --base=./",
    "desktop:windows": "npm run desktop:build && electron-builder --win",
    "desktop:linux": "npm run desktop:build && electron-builder --linux",
    "desktop:mac": "npm run desktop:build && electron-builder --mac",
    "desktop:all": "npm run desktop:build && electron-builder --win --linux --mac",
    "web:build": "vite build",
    "mobile:init": "npm install @capacitor/core @capacitor/cli @capacitor/android @capacitor/ios",
    "mobile:sync": "npm run web:build && npx cap sync",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:ios": "npm run mobile:sync && npx cap open ios"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@huggingface/transformers": "^3.8.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "oxfmt": "^0.2.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "main": "electron/main.cjs",
  "description": "NOVOS universal operating system project"
}
